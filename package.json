{
  "name": "bartudonmez-localrag",
  "version": "1.0.0",
  "description": "Offline Local RAG study assistant using Microsoft Foundry Local, Express, SQLite, and TF-IDF retrieval",
  "type": "module",
  "scripts": {
    "ingest": "node src/ingest.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "train": "node src/trainer.js",
    "train:quick": "node src/trainer.js --quick",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.0",
    "foundry-local-sdk": "^0.9.0"
  },
  "license": "MIT",
  "keywords": [
    "rag",
    "offline-ai",
    "foundry-local",
    "phi-3",
    "sqlite",
    "tfidf",
    "summer-school"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
